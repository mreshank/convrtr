{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm build",
	"outputDirectory": "out",
	"framework": null,
	"cleanUrls": true,
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
				{ "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
			]
		}
	]
}
