# Clerk Authentication (Optional)
# Conversions run 100% client-side. Provide your Clerk publishable key to enable
# Google One Tap, user logins, and 90-day conversion audit history.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend Mail (Vercel Functions in /api/*)
# RESEND_API_KEY lives in Vercel env already — never commit it, never prefix with NEXT_PUBLIC.
RESEND_API_KEY=
# Verified sender on your @convrtr.mreshank.com domain
MAIL_FROM=hello@convrtr.mreshank.com
# Maintainer inbox for contact/feedback/support intake
MAIL_TO=contact@mreshank.com
# Optional: Resend Audience ID for contact sync (subscribe/unsubscribe)
RESEND_AUDIENCE_ID=
# Required for POST /api/campaign — admin UI sends it as Bearer token, fail-closed when empty
ADMIN_API_SECRET=
