{
	"manifest_version": 3,
	"name": "convrtr",
	"version": "0.1.0",
	"description": "Universal in-browser file converter. Convert, compress, transpile, extract, and decrypt files locally with zero server uploads.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "convrtr — Universal File Converter",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["sidePanel", "storage", "contextMenus", "tabs", "downloads"],
	"commands": {
		"open_side_panel": {
			"suggested_key": {
				"default": "Ctrl+Shift+C",
				"mac": "Command+Shift+C"
			},
			"description": "Toggle convrtr Side Panel"
		}
	}
}
