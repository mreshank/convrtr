{
	"manifest_version": 3,
	"name": "convrtr",
	"version": "0.2.4",
	"description": "Private in-browser file converter. Convert media and documents locally using WebAssembly with zero server uploads.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "convrtr - File Converter",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": [
		"sidePanel",
		"storage",
		"contextMenus",
		"scripting",
		"activeTab"
	],
	"commands": {
		"open_popup": {
			"suggested_key": {
				"default": "Ctrl+Shift+Comma",
				"mac": "Command+Shift+Comma"
			},
			"description": "Open convrtr Quick Popup"
		},
		"open_side_panel": {
			"suggested_key": {
				"default": "Ctrl+Shift+C",
				"mac": "Command+Shift+C"
			},
			"description": "Toggle convrtr Side Panel"
		},
		"capture_tab": {
			"suggested_key": {
				"default": "Ctrl+Shift+S",
				"mac": "Command+Shift+S"
			},
			"description": "Capture visible page and stage into convrtr"
		}
	},
	"omnibox": {
		"keyword": "cv"
	}
}
