# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist-extension/
/convrtr-extension*.zip

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# scratch from browser-driven verification
/.playwright-mcp/
# evidence a review pass drops in the repo root -- never committed
/review-screens/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch space — never commit
/.superpowers/
/.worktrees/

# ffmpeg.wasm core, copied from node_modules at build time (31MB)
public/ffmpeg/

# sql.js core, copied from node_modules at build time (658KB)
public/sql-wasm/

# 7-Zip core, copied from node_modules at build time (1.6MB)
public/7z/
